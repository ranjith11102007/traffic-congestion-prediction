# -----------------------------------------------------------------------------
# Environment configuration template.
#
# Copy this file to `.env` in the project root and fill in real values:
#     Windows PowerShell : Copy-Item .env.example .env
#     macOS / Linux      : cp .env.example .env
#
# `.env` is git-ignored. Never commit real credentials, API keys or tokens.
# Every value here is optional unless stated otherwise; the API starts without a
# database and reports a clear configuration error for database-backed routes.
# -----------------------------------------------------------------------------

# --- Database ----------------------------------------------------------------
# SQLAlchemy PostgreSQL DSN.
# Format: postgresql+psycopg2://<user>:<credential>@<host>:<port>/<database>
#
# Required for the traffic observation, prediction and collector endpoints, and
# for Alembic. To create the schema:
#     alembic upgrade head
#
# Leave empty to run with no database: GET /api/health still works, and the
# database-backed endpoints return a configuration_error.
DATABASE_URL=

# Log every SQL statement. Useful while debugging, noisy in normal use.
DB_ECHO=false

# SQLAlchemy connection-pool tuning (PostgreSQL only).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Seconds to wait when opening a new database connection.
DB_CONNECT_TIMEOUT=5

# When true the API refuses to start if PostgreSQL is unreachable.
# Set true in production so a bad DSN fails loudly at boot rather than on the
# first request.
DB_FAIL_FAST=false

# --- API server --------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# Auto-reload on code changes. Set false for anything other than local dev.
API_RELOAD=true

# One of: CRITICAL, ERROR, WARNING, INFO, DEBUG
API_LOG_LEVEL=INFO

# --- Service metadata --------------------------------------------------------
# Reported as the "service" field by GET /api/health
SERVICE_NAME=traffic-prediction-api

# development | staging | production
ENVIRONMENT=development
#
# Production hard guard: when ENVIRONMENT=production the application refuses to
# start unless ALL of the following are set. This is an intentional fail-fast —
# an operator who forgets any one of them would otherwise serve simulated data
# or an unusable stack while looking healthy.
#   * TRAFFIC_PROVIDER=real                 (never simulation in production)
#   * TRAFFIC_API_KEY=<real TomTom key>
#   * DATABASE_URL=postgresql+psycopg2://...
#   * DB_FAIL_FAST=true                     (recommended, fail at boot on a bad DSN)

# --- CORS --------------------------------------------------------------------
# JSON list of browser origins allowed to call the API.
# "null" is included because browsers send `Origin: null` for pages opened
# directly from the filesystem (file://). The API never uses cookies, so
# credentials are not allowed.
CORS_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000","http://127.0.0.1:5500","http://localhost:5500","null"]

# --- Traffic data provider ---------------------------------------------------
# Which provider the collector uses:
#   simulation  synthetic development data, clearly labelled, needs no credentials
#   real        live traffic from TomTom + weather from Open-Meteo
#
# "real" fails with a provider_not_configured error when its credentials are
# missing. It never falls back to simulated data: fabricated readings stored
# under a real provider's name are worse than an outage.
# With ENVIRONMENT=production, "simulation" is rejected outright at start-up.
TRAFFIC_PROVIDER=simulation

# Which vendor's request/response mapping to use. Only "tomtom" is implemented;
# an unknown value is rejected at start-up rather than guessed at, because the
# response shapes are not interchangeable.
TRAFFIC_API_VENDOR=tomtom

# Base URL of the traffic API. The default is TomTom's global endpoint and must be
# https, because the API key travels as a query parameter.
TRAFFIC_API_BASE_URL=https://api.tomtom.com

# TomTom API key. Leave empty to mean "unconfigured" — the app still starts and
# GET /api/health still works. Create one at https://developer.tomtom.com/.
# TomTom documents a 20,000 requests/month allowance for the Traffic Flow API
# Segment Data product with no credit card; with 6 locations at the default
# interval that is roughly 15 collection cycles per day against 12,000 reads.
TRAFFIC_API_KEY=

# Zoom level for the point query. Higher values see more minor roads but shift
# which segment a coordinate resolves to, so raise it only deliberately.
TRAFFIC_ZOOM=10

# Seconds to wait for a single upstream traffic request.
TRAFFIC_REQUEST_TIMEOUT=10

# Minimum seconds between upstream traffic requests. TomTom documents 10 queries
# per second for non-tile traffic endpoints; 0.15s keeps a 6-location cycle well
# inside that without depending on the limit holding under load.
TRAFFIC_MIN_REQUEST_INTERVAL=0.15

# Upper bound on how many monitored roads one cycle may query. Guards against a
# configuration mistake spending a month's free quota in a single run.
TRAFFIC_MAX_LOCATIONS=25

# --- Monitored roads ---------------------------------------------------------
# JSON file describing which roads to query and how each maps to an ML feature.
# The default is config/monitored_locations.json; an absolute path is used as
# given, a relative one is resolved against the project root.
#
# `road_segment_id` must be one of SEG-01..SEG-06. Anything else is rejected on
# load: the model was never trained on it, so a reading for that segment could
# not be scored.
#
# `free_flow_speed_kph_max` is a sanity bound per road. A reading above it is
# logged as a warning, because it usually means the coordinate fell on the wrong
# segment rather than that the road is faster than documented.
TRAFFIC_LOCATIONS_FILE=

# --- Weather provider --------------------------------------------------------
# Weather comes from Open-Meteo, which needs no API key for non-commercial use
# and documents a 10,000 calls/day, 300,000/month allowance
# (https://open-meteo.com/en/pricing). Set false to skip the weather request,
# but note that model version 4.0.0 requires weather_condition, so observations
# collected that way cannot be scored.
WEATHER_ENABLED=true
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1
WEATHER_REQUEST_TIMEOUT=10

# Unused. Open-Meteo's free tier takes no key; the setting exists only for a
# future commercial endpoint, which would also need a different host.
WEATHER_API_KEY=

# --- Background collection ---------------------------------------------------
# Run periodic collection in the background.
#
# Off by default. Every enabled cycle spends vendor quota and writes rows, so it
# is an explicit operational decision rather than a side effect of starting the
# API.
#
# Real deployments need this: TomTom publishes current conditions only, and the
# model needs 6 prior readings per segment before it will score. Without a
# scheduler (or POSTing observations yourself) a live location stays
# permanently unscoreable.
COLLECTION_ENABLED=false

# Seconds between cycles. Minimum 30. The default 300s means 12 cycles/hour, or
# 288 reads/day across the 6 roads in the shipped locations file.
COLLECTION_INTERVAL_SECONDS=300

# Score each stored reading with the model as soon as it is collected.
#
# On by default: the only reason to turn it off is if you are writing readings
# for a purpose other than forecasting them, or you want to control when
# prediction runs yourself (POST /api/traffic/observations/{id}/predict).
# A prediction failure never costs an observation — the reading is stored first
# either way, and the response reports per-reading outcomes.
AUTO_PREDICT_AFTER_COLLECTION=true

# --- Dashboard ---------------------------------------------------------------
# Seconds before a stored observation counts as stale. The dashboard compares
# the newest observation timestamp against this and reports `fresh`, `stale` or
# `unavailable`. It is not a cache TTL and nothing expires or is deleted: old
# readings stay useful and stay in the database.
#
# 900 (15 minutes) is three default collection intervals, so a scheduler that
# has missed two cycles still reports `fresh` while one that has stopped
# reports `stale`.
DATA_FRESHNESS_THRESHOLD_SECONDS=900

# Upper bound on a trend window in hours, in case a client asks for more.
# 168 (7 days) at 5-minute resolution would be about 2,000 points, which is
# where a chart stops being legible anyway.
DASHBOARD_TREND_MAX_HOURS=168

# --- Static dashboard --------------------------------------------------------
# Directory holding the static dashboard (frontend/index.html, js, css). When
# set and present on disk, the API serves the UI from its own origin — this is
# how single-URL deployments (Docker, Render) publish the dashboard with no CORS
# and no second service. Empty keeps the API JSON-only. Relative paths are
# resolved against the project root.
#
#     Docker:   FRONTEND_DIR=/app/frontend
#     Render:   FRONTEND_DIR=frontend
FRONTEND_DIR=

# --- ML inference ------------------------------------------------------------
# Directory holding the trained artifacts. Empty means `ml/models`, resolved from
# the repository layout. Train with:
#     python -m ml.train
ML_MODELS_DIR=

# How many prior observations per road segment to load when scoring. Must be at
# least the model's min_history_per_segment (6), because the lag and rolling
# features read backwards. A location needs a run of readings before any
# forecast is meaningful; use POST /api/traffic/collect/history to backfill.
ML_PREDICTION_HISTORY=12