secrets/
credentials.json

# ============================================================================
# Generated ML artifacts and datasets
#
# Model binaries and raw datasets are reproducible from the data pipeline, so
# they are not tracked. The directory placeholders (.gitkeep) are kept.
# ============================================================================
ml/models/*
!ml/models/.gitkeep

# Real datasets supplied by an operator. Never committed: they may be licensed
# or too large for the repository. The README documenting the required schema is
# tracked, so the contract survives even though the data does not.
ml/data/raw/*
!ml/data/raw/.gitkeep
!ml/data/raw/README.md

# The simulated fixture is deterministic: regenerate it with
# `python -m ml.data.sample.generate_simulated_dataset` rather than tracking it.
# The generator and its README are tracked.
ml/data/sample/*.csv
ml/data/sample/*.csv.provenance.json

# Generated by `python -m ml.preprocessing`; reproducible from the source data.
ml/data/processed/*
!ml/data/processed/.gitkeep
!ml/data/processed/README.md
*.joblib
*.pkl
*.pickle
*.onnx
*.h5
*.parquet

# ============================================================================
# Frontend
# ============================================================================
node_modules/
frontend/vendor/
*.min.js
*.min.css
*.map

