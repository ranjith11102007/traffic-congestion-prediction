*.swo
.DS_Store
Thumbs.db
desktop.ini

# ============================================================================
# Local developer database: never commit a working copy. The deployed host
# creates its own store from ALembic.
# ============================================================================
*.db
*.db-*
*.sqlite
*.sqlite3

# ============================================================================
# Tracked exceptions
#
# These ARE committed on purpose so a clean clone (CI, Render) is fully
# functional instead of quietly degraded:
#
#  - frontend/vendor/ - Leaflet and Chart.js are vendored (no CDN). The
#    dashboard and the Stage 7 frontend tests need them from a fresh checkout.
#  - ml/models/ - the trained artifact bundle lets the hosted API score readings
#    without a training step. Reproducible via ``python -m ml.train`` but
#    shipped so the public demo and CI behave identically to local runs.
#
# The negation rules below override the generic excludes above because
# gitignore keeps the LAST matching pattern.
# ============================================================================
!frontend/vendor/
frontend/vendor/*
!frontend/vendor/leaflet.js
!frontend/vendor/leaflet.css
!frontend/vendor/chart.umd.min.js

!ml/models/
ml/models/*
!ml/models/.gitkeep
!ml/models/traffic_model.pkl
!ml/models/preprocessor.pkl
!ml/models/model_metadata.json
!ml/models/feature_importance.json
!ml/models/evaluation_results.json
!ml/models/model_report.md
!ml/models/confusion_matrix.png